# Apache: keep non-public files from being served.
# .sql files hold database passwords; config.php holds credentials; the .git
# directory exposes history. None of these should ever be fetchable.

<IfModule mod_authz_core.c>
  # Apache 2.4+
  <FilesMatch "\.(sql|md)$">
    Require all denied
  </FilesMatch>
  <Files "config.php">
    Require all denied
  </Files>
  <Files "config.example.php">
    Require all denied
  </Files>
</IfModule>

<IfModule !mod_authz_core.c>
  # Apache 2.2
  <FilesMatch "\.(sql|md)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <Files "config.php">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>

# Block the git directory and the raw card data outright.
RedirectMatch 404 /\.git
RedirectMatch 404 /data/

# manifest.json MUST stay reachable or the app will not install to the home
# screen, so .json is deliberately not blocked wholesale — /data/ is blocked
# by path above instead.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Service worker must be served from the app root with no long-lived cache,
# otherwise updates never reach an installed app.
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  <Files "manifest.json">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
